      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "GET /cvs sin autenticacion -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cvs",
              "host": ["{{baseUrl}}"],
              "path": ["cvs"]
